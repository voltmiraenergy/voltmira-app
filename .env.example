# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only, never expose to client

# ---- Stripe (Dashboard → Developers → API keys) ----
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...     # from `stripe listen` or dashboard webhook
STRIPE_PRICE_PRO=price_...          # €49/mo price id
STRIPE_PRICE_TEAM=price_...         # €99/mo price id

# ---- Paddle Billing (recommended for Moldova — merchant of record, handles EU VAT) ----
# Client (NEXT_PUBLIC_*) values are safe to expose; PADDLE_WEBHOOK_SECRET is server-only.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_or_test_...   # Paddle → Developer tools → Authentication
NEXT_PUBLIC_PADDLE_ENV=sandbox                     # "sandbox" while testing, "production" when live
NEXT_PUBLIC_PADDLE_PRICE_PRO=pri_...               # €49/mo price id (Paddle → Catalog → Prices)
NEXT_PUBLIC_PADDLE_PRICE_TEAM=pri_...              # €99/mo price id
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...               # Paddle → Notifications → your destination → signing secret

# ---- App ----
NEXT_PUBLIC_APP_URL=https://app.voltmira.com
GEOCODER_EMAIL=contact@voltmira.com

# ---- Rate limiting (Upstash Redis, free tier) ----
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=A...

# ---- Bot protection (Cloudflare Turnstile, free) ----
# Site key goes here; the SECRET key goes into Supabase:
# Dashboard → Authentication → Attack Protection → CAPTCHA → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAA...

# ---- Email notifications (Resend, free tier 100/day) ----
# Verify your domain at resend.com, then:
RESEND_API_KEY=re_...
RESEND_FROM="VoltMira <notify@voltmira.com>"
