# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only, never expose to client

# ---- Stripe (Dashboard → Developers → API keys) ----
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...     # from `stripe listen` or dashboard webhook
STRIPE_PRICE_PRO=price_...          # €49/mo price id
STRIPE_PRICE_TEAM=price_...         # €99/mo price id

# ---- Paddle Billing (recommended for Moldova — merchant of record, handles EU VAT) ----
# Client (NEXT_PUBLIC_*) values are safe to expose; PADDLE_WEBHOOK_SECRET is server-only.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_or_test_...   # Paddle → Developer tools → Authentication
NEXT_PUBLIC_PADDLE_ENV=sandbox                     # "sandbox" while testing, "production" when live
NEXT_PUBLIC_PADDLE_PRICE_PRO=pri_...               # €49/mo price id (Paddle → Catalog → Prices)
NEXT_PUBLIC_PADDLE_PRICE_TEAM=pri_...              # €99/mo price id
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...               # Paddle → Notifications → your destination → signing secret

# ---- App ----
NEXT_PUBLIC_APP_URL=https://app.voltmira.com
GEOCODER_EMAIL=contact@voltmira.com

# ---- Site Designer satellite imagery (optional) ----
# Unset: Site Designer uses free Esri World Imagery, no key needed. Set your
# own Google Cloud key here (console.cloud.google.com → APIs & Services →
# enable "Maps JavaScript API" → Credentials, billing account required) to
# switch to Google's higher-resolution satellite tiles instead. Restrict the
# key to your app's domain(s) in the Cloud Console, and to the Maps
# JavaScript API only. This is a NEXT_PUBLIC_* value — it ends up in the
# browser bundle, same as any Google Maps embed key; domain restriction is
# what keeps it safe to expose, not secrecy.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Rate limiting (Upstash Redis, free tier) ----
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=A...

# ---- Bot protection (Cloudflare Turnstile, free) ----
# Site key goes here; the SECRET key goes into Supabase:
# Dashboard → Authentication → Attack Protection → CAPTCHA → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAA...

# ---- Email notifications (Resend, free tier 100/day) ----
# Verify your domain at resend.com, then:
RESEND_API_KEY=re_...
RESEND_FROM="VoltMira <notify@voltmira.com>"

# ---- Vercel Cron (existing /api/cron/* routes) ----
# Any random string; Vercel Cron sends it back as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=...

# ---- Make.com automations (see docs/MAKE_AUTOMATIONS.md) ----
# Any random string of your own choosing (e.g. `openssl rand -hex 32`) — the
# SAME value goes into your Make.com scenarios (as a header check for the
# Q&A webhook, and as the bearer token for the two nudge endpoints Make calls
# into). Both features are inert with these unset: the Q&A widget shows a
# fixed fallback, and /api/automation/nudges/* refuses every request.
AUTOMATION_API_KEY=...
MAKE_QA_WEBHOOK_URL=https://hook.make.com/...
